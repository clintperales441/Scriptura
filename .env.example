# Scriptura — English Writing Practice App
# Copy this file to .env and fill in your values

# Application
APP_TITLE=Scriptura
DEBUG=true

# AI Configuration
# Set AI_PROVIDER to "gemini" and provide your API key to enable AI review.
# Leave AI_PROVIDER as "mock" (or unset GEMINI_API_KEY) to use the mock reviewer.
AI_PROVIDER=mock
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
AI_TIMEOUT_SECONDS=30
